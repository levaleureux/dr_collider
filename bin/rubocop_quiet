#!/usr/bin/env ruby
# frozen_string_literal: true

# Wrapper quiet pour Rubocop.
# Succès: "Rubocop: N files, no offenses"
# Échec:  "Rubocop: N offense(s)\n  path:line [S] Cop"
#
# Le périmètre est défini par AllCops/Include dans .rubocop.yml.

require "json"
require "open3"

stdout, _stderr, status = Open3.capture3("rubocop", "--format", "json")

begin
  result = JSON.parse(stdout)
rescue JSON::ParserError => error
  warn "Rubocop JSON error: #{error.message}"
  exit 1
end

summary = result["summary"] || {}
count = summary["offense_count"].to_i
files = summary["target_file_count"].to_i

if count.zero? && status.success?
  puts "Rubocop: #{files} files, no offenses"
  exit 0
end

puts "Rubocop: #{count} offense(s)"

(result["files"] || []).each do |file|
  file["offenses"]&.each do |o|
    loc = "#{file['path']}:#{o.dig('location', 'line')}"
    puts "  #{loc} [#{o['severity']&.chr&.upcase}] #{o['cop_name']}"
  end
end
exit 1
